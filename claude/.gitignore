# Rust
/target
**/*.rs.bk

# Node
node_modules/
client/dist/
# The --mode e2e bundle, built by scripts/checks/no-dev-surface.mjs.
client/dist-e2e/
client/.vite/

# WASM build output (generated by wasm-pack, never committed)
client/src/core/pkg/

# Gate logs. Named per agent (`gate-<who>.txt`) so two agents never share one.
# Untracked, they were reaching `scripts/affected.mjs` as paths no rule knows,
# and each one prints "everything" — so eighteen stale logs forced a 17-minute
# full run on a prose-only change. Measured 2026-09-21, not assumed.
gate-*.txt

# Debug artifacts
/debug/
recordings/
replays/
target/mapdump/

# Env
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
shots/

# Vendored art: 15MB+ against a 12MB budget (docs/70-amendments-v2.md A29).
# scripts/fetch-assets.sh restores it; assets/atlas/ is what ships.
#
# The contents, not the directory: git does not descend into an excluded
# directory, so `assets/vendor/` would make the negation below unreachable and
# README.md would stay untracked. docs/51 §8 wants the provenance recorded in
# the repository, and a record that only exists on one machine records nothing.
assets/vendor/*
!assets/vendor/README.md
.run/

# Ad-hoc check re-run logs. Same reason as gate-*.txt: an untracked path at the repo
# root is a path `scripts/affected.mjs` has no rule for, and it prints "everything" —
# so one stray log turns every `--changed` in the tree into the full browser gate.
rerun-*.txt
