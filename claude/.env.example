# Copy to .env; compose reads it. .env is gitignored, this file is committed.
# Semantics: docs/41-server-loop-rooms.md §5.

GAME_LOG=info
MAP_SCALE=large
MAX_PLAYERS=6
ROUND_SECONDS=240

# Set to reproduce a specific map: FIXED_SEED=8123491234
FIXED_SEED=

RECORD_REPLAY=0
DEBUG_DUMP=0

# v2 (docs/70-amendments-v2.md §A5)
# Seconds a public lobby waits before bots fill it and the match starts (§E2).
# Raise it to watch a lobby in a browser: a cold page needs longer than 10 s to
# load, so at the default the match has already begun by the time you can look.
LOBBY_BOT_TIMEOUT=10
BOT_COUNT=3
BOT_SKILL=0.6
